# ============================================
# CONFIGURATION DE L'APPLICATION
# ============================================
# Copier ce fichier vers .env et remplir les valeurs

# ============================================
# BASE DE DONNÉES
# ============================================

# URI de connexion MongoDB
# Pour Docker : mongodb://mongodb:27017/Streaming_platform
# Pour local  : mongodb://localhost:27017/Streaming_platform
# Pour production avec auth : mongodb://username:password@host:27017/Streaming_platform
MONGODB_URI=mongodb://mongodb:27017/Streaming_platform

# ============================================
# SERVEUR
# ============================================

# Port d'écoute du serveur Express
# Par défaut : 3500 (Docker) ou 5000 (local)
PORT=3500

# ============================================
# SÉCURITÉ
# ============================================

# Secret pour signer les tokens JWT (JSON Web Tokens)
# IMPORTANT : Changer cette valeur en production !
# Pour générer un secret sécurisé :
#   - Linux/macOS : openssl rand -hex 32
#   - Node.js : require('crypto').randomBytes(32).toString('hex')
JWT_SECRET=music_stream

# Durée de validité des tokens JWT
# Format : 7d (7 jours), 24h (24 heures), 60m (60 minutes)
JWT_EXPIRES_IN=7d

# ============================================
# CLOUDINARY - STOCKAGE CLOUD DES MÉDIAS
# ============================================

# Nom de votre cloud Cloudinary
# Obtenir sur : https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=votre_cloud_name

# Clé API Cloudinary
CLOUDINARY_API_KEY=votre_api_key

# Secret API Cloudinary
CLOUDINARY_API_SECRET=votre_api_secret

# ============================================
# CONFIGURATION OPTIONNELLE
# ============================================

# Environnement d'exécution
# development | production | test
NODE_ENV=production

# Niveau de logs
# error | warn | info | debug
LOG_LEVEL=info

# ============================================
# NOTES
# ============================================
#
# 1. Pour créer votre fichier .env :
#    cp .env.example .env
#
# 2. Pour Docker, utilisez les valeurs de .env.docker
#
# 3. Ne JAMAIS commit le fichier .env dans Git
#
# 4. Pour obtenir des identifiants Cloudinary gratuits :
#    - Aller sur https://cloudinary.com
#    - Créer un compte gratuit
#    - Copier vos identifiants depuis le Dashboard
#
# 5. Générer un JWT_SECRET sécurisé :
#    openssl rand -hex 32
#
# 6. Pour la production, utilisez des variables d'environnement
#    du système ou des secrets Docker/Kubernetes
#
