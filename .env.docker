# Configuration Docker pour Music Streaming Platform
# Ce fichier contient les variables d'environnement adaptées pour Docker

# Base de données MongoDB (utilise le nom du service Docker au lieu de localhost)
MONGODB_URI=mongodb://mongodb:27017/Streaming_platform

# Port du serveur
PORT=3500

# Secret pour JWT (utilisé pour signer les tokens d'authentification)
JWT_SECRET=music_stream

# Configuration Cloudinary (hébergement des images)
CLOUDINARY_CLOUD_NAME=dcyyqpt4a
CLOUDINARY_API_KEY=999954749786322
CLOUDINARY_API_SECRET=LXtGpTO0eN2t1dR5HOWihCUmKPQ

# Note importante :
# - MONGODB_URI utilise 'mongodb' (nom du service Docker) au lieu de 'localhost'
# - En production, il est recommandé de changer JWT_SECRET et les credentials Cloudinary
# - Pour un déploiement sécurisé, utilisez Docker secrets au lieu de variables d'environnement
